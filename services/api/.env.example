# Privy app ID and the verification key (PEM) from Privy dashboard > App settings > Verification key.
# Write the PEM on one line with "\n" between lines, wrapped in double quotes.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=""

# Monad testnet (chain ID 10143). Confirm against docs.monad.xyz before changing.
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz

# DemoUSD deployment (contracts/demo-token). Required for token-transfer checks.
DEMO_TOKEN_ADDRESS=
DEMO_TOKEN_DECIMALS=6
DEMO_TOKEN_SYMBOL=DemoUSD

# Fee pinning. Monad charges the full gas limit, so keep the margin modest.
GAS_MARGIN_BPS=1000
BASE_FEE_MULTIPLIER=2

CORS_ORIGINS=["http://localhost:3000"]
